[Unit]
Description=WeatherTag e-paper weather display
Documentation=https://github.com/tsl0922/EPD-nRF5
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/weathertag
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/bt-dbus/system_bus_socket
ExecStart=/root/weathertag/.venv/bin/weathertag serve --config /root/weathertag/config.toml
Restart=on-failure
RestartSec=15s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/root/weathertag/var

[Install]
WantedBy=multi-user.target
